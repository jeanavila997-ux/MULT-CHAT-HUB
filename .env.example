# Chave de ativação do servidor (obrigatória — servidor não sobe sem este valor)
# Crie um arquivo apps/lite/.env.local (ignorado pelo git) com o valor real:
#   APP_ACTIVATION_SECRET="sua-chave-secreta"
APP_ACTIVATION_SECRET=""
# Opcional para o frontend Vite enviar x-mch-activation-secret automaticamente.
# Em produção local, prefira preencher via localStorage (mch:activation-secret) se não quiser embutir no bundle.
VITE_APP_ACTIVATION_SECRET=""

# Backend de LLM local/remote
# 1) Ollama local
#    Instale: https://ollama.com  -- rode: 'ollama serve' + 'ollama pull fazendaavila2026/avila'
OLLAMA_HOST="http://127.0.0.1:11434"
OLLAMA_MODEL="fazendaavila2026/avila:latest"

# 2) llama.cpp local (servidor HTTP OpenAI-compatible)
#    Exemplo: llama-server --port 8080 --model /caminho/para/model.gguf
#    e depois use LLM_BASE_URL="http://127.0.0.1:8080/v1"
LLM_PROVIDER="ollama"
LLM_BASE_URL="http://127.0.0.1:8080/v1"
LLM_MODEL="local-model"
LLM_API_KEY=""

# Opcional: token GitHub para as ferramentas github_list_repos / github_create_issue
# (lido em server/controllers/toolController.ts — NÃO use prefixo VITE_ para não expor no bundle)
GITHUB_TOKEN=""

# LLM Cloud Providers — fallback server-side (configuração na UI do AgentConfig é preferida)
# Chaves inseridas na UI são passadas por request e têm prioridade sobre estas vars.
# Exemplos válidos para LLM_PROVIDER: "ollama", "llamacpp", "openai", "grok", "grok_bot",
# "codex", "claude_code", "hermes", "opencode", "router9", "deepseek", "nvidia", "cloudflare",
# "powershell", "cli"
OPENAI_API_KEY=""

# Obrigatório para o Agente de Cibersegurança (Claude API via Anthropic SDK)
# Gere em: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
GROK_API_KEY=""
HERMES_API_KEY=""
DEEPSEEK_API_KEY=""

# JARVIS — provedor de orquestração. Use o local sem senha ou a VPS com Basic Auth.
JARVIS_URL="http://127.0.0.1:3200"
JARVIS_USER=""
JARVIS_PASS=""

# 9Router — gateway local OpenAI-compatible
ROUTER_BASE_URL="http://127.0.0.1:20128/v1"
ROUTER_API_KEY=""
ROUTER_MODEL="cx/gpt-5.6-sol"

# NVIDIA NIM — chave em https://build.nvidia.com (endpoint https://integrate.api.nvidia.com/v1)
NVIDIA_API_KEY=""

# Cloudflare Workers AI — endpoint https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
# Token: dash.cloudflare.com → My Profile → API Tokens (permissão "Workers AI: Read")
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# Opcional: porta do backend Express do apps/lite (padrão 3000). O proxy /api do Vite segue este valor.
# PORT=3000

# ── Agente local (tool-calling no Ollama: "Ferramentas: ON" na interface) ──
# Ferramentas que escrevem/executam pedem confirmação na interface. Nunca há fallback para provedor pago.
# Pastas de skills separadas por ";" (relativas a apps/lite). A última ganha se o nome repetir. Vazio = "skills".
SKILLS_DIRS=""
# Máximo de rodadas de ferramenta por mensagem (padrão 5, máx 10)
AGENT_MAX_TOOL_ITERATIONS=""

# Mestre do PC — MCP Streamable HTTP local, ex.: http://127.0.0.1:7777/mcp
MESTRE_MCP_URL=""
MESTRE_MCP_TOKEN=""
# Ferramentas MCP que rodam sem confirmação (vírgula). Vazio = mestre_system_status,mestre_list_operations,mestre_list_memories
MESTRE_MCP_READONLY_TOOLS=""

# Notas do Obsidian (busca somente leitura em .md). COFRE REMOTO é sempre bloqueado.
OBSIDIAN_VAULT_PATH=""

# Memória compartilhada (memory_save / memory_search) — tabela em supabase/migrations/*_agent_memories.sql
# Usa SUPABASE_SERVICE_ROLE_KEY (acima), só no servidor. Sem a chave, as ferramentas ficam desligadas.
SUPABASE_URL=""
SUPABASE_MEMORY_TABLE=""

# Hermes da VPS (API em 127.0.0.1:8642 NA VPS, não pública). Abra um túnel antes:
#   ssh -N -L 8642:127.0.0.1:8642 root@72.62.11.116
# e use HERMES_BASE_URL="http://127.0.0.1:8642" (HERMES_API_KEY acima = API_SERVER_KEY do Hermes).
HERMES_BASE_URL=""
HERMES_MODEL=""

# n8n: allowlist de webhooks "nome=https://url;outro=https://url". Só estes podem ser disparados.
N8N_WEBHOOKS=""

# Supabase — obrigatório para apps/cloud (Next.js SaaS)
# Crie seu projeto em: https://supabase.com/dashboard
# Project Settings → API → Project URL e anon/public key
NEXT_PUBLIC_SUPABASE_URL="https://dvouunnccyciiussjxla.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_0miZcaY13hyElpQ8Ce65_g_5B-YDTeh"
# Service role key (backend apenas — NUNCA expor no frontend)
SUPABASE_SERVICE_ROLE_KEY=""

# ── Gateway externo (NullClaw) ────────────────────────────────────────────────
# Hosts que o servidor do lite pode chamar no pareamento/mensagens (separados por vírgula).
# Vazio = só este PC (127.0.0.1, localhost, [::1]). O token pareado fica em apps/lite/data/gateways.json.
GATEWAY_ALLOWED_HOSTS=
